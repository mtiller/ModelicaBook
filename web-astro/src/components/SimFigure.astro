---
// MIC-84 bake-off — the interactive figure as a native Astro island.
//
// The whole point vs. mystmd: this is just a component you import in MDX and
// use (<SimFigure id="FO" interactive />). The structured case contract flows
// straight in as a prop, the DOM carries `data-*` attributes untouched, and the
// <script> below is bundled + executed by Astro. No theme fork, no post-build
// injection, no sanitizer fight. Additional figure/island types = more
// components, never touching upstream.
//
// Structure follows Jony's shared skeleton (data-state root, no disclosure
// toggle, params from first paint, static <img> always present as the base
// case, canvas overlay for future live sim). Styling is entirely via the
// data-skin × data-mode token system in src/styles/skins.css.
import { cases } from '../cases';

interface Props {
  id: string;
  interactive?: boolean;
  caption?: string;
}
const { id, interactive = false, caption = '' } = Astro.props;
const c = cases[id];
// Degrade gracefully: if interactive is requested but the case contract hasn't
// been generated yet (asset pipeline — MIC-87), fall back to the static figure
// instead of failing the build. Interactive lights up automatically once
// src/cases/<id>.json exists.
const staticSrc = `/plots/${id}.svg`;
// Editable params come straight from the contract (editable ⇔ variability was
// "parameter"). FO/FOE are parameter-free, so this is empty and the panel shows
// read-only sim config — the correct degenerate behavior.
const editable = (c?.params ?? []).filter((p) => p.editable);
// Only render the interactive panel when there are actual adjustable parameters
// (MIC-135). Parameter-free figures fall back to the static plot — no confusing
// empty "no adjustable parameters" panel or dead Run button. When live sim
// (MIC-86) lands and params are populated (MIC-135 part 1 data), these light up.
const showInteractive = interactive && !!c && editable.length > 0;
---

{showInteractive ? (
  <figure
    class="mbe-figure interactive"
    data-plot-id={id}
    data-state="static"
    data-case={JSON.stringify(c)}
  >
    <header class="mbe-figure__header">
      <span class="mbe-figure__label">{caption || c.title}</span>
      <span class="mbe-figure__badge" hidden>live</span>
    </header>

    <div class="mbe-figure__body">
      <div class="mbe-figure__params">
        <div class="mbe-figure__params-title">Model Parameters</div>
        {editable.length > 0 ? (
          <div class="mbe-figure__param-list">
            {editable.map((p) => {
              // No model description in the book declares a `max` -- 178 of 778
              // editable parameters carry a `min` and none a maximum -- so a
              // slider's upper bound has to be derived. Bracket the model's own
              // value, which is the one the book's figure uses, and keep `min`
              // as a hard floor where the FMU states one. The number box beside
              // it stays authoritative for values outside the bracket.
              const v = Number(p.default);
              const span = Number.isFinite(v) && v !== 0 ? Math.abs(v) * 3 : 1;
              const lo = p.min !== undefined ? Number(p.min)
                       : (Number.isFinite(v) ? v - span : 0);
              const hi = Number.isFinite(v) ? v + span : 1;
              const step = (hi - lo) / 200;
              const slider = Number.isFinite(v) && p.type !== 'Boolean' && hi > lo;
              return (
                <div class="mbe-figure__param">
                  <label class="mbe-param__label" for={`p-${id}-${p.key}`} title={p.description || p.label}>
                    {p.label}
                    {p.unit && <span class="mbe-param__unit">{p.displayUnit || p.unit}</span>}
                  </label>
                  <input
                    class="mbe-param__input"
                    id={`p-${id}-${p.key}`}
                    type="number"
                    step="any"
                    value={String(p.default)}
                    title={p.description || p.label}
                  />
                  {slider && (
                    <input
                      class="mbe-param__slider"
                      type="range"
                      min={String(lo)}
                      max={String(hi)}
                      step={String(step)}
                      value={String(v)}
                      aria-labelledby={`p-${id}-${p.key}`}
                      data-for={`p-${id}-${p.key}`}
                    />
                  )}
                </div>
              );
            })}
          </div>
        ) : (
          <dl class="mbe-figure__param-list mbe-figure__param-list--readonly">
            <dt>Model</dt><dd>{c.name.split('.').pop()}</dd>
            <dt>Stop time</dt><dd>{c.stopTime ?? '—'}</dd>
            <dt>Tolerance</dt><dd>{c.tol}</dd>
          </dl>
        )}
        <div class="mbe-figure__actions">
          <span class="mbe-figure__hint">
            {editable.length > 0 ? 'Drag a slider, or edit a value and press Run' : 'No adjustable parameters'}
          </span>
          <button class="mbe-figure__run" type="button" title="Simulate this model in your browser">
            Run
          </button>
        </div>
      </div>

      <div class="mbe-figure__plot">
        <img class="mbe-figure__static" src={staticSrc} alt={caption || id} loading="lazy" />
        <canvas class="mbe-figure__canvas" hidden></canvas>
        <div class="mbe-figure__status" aria-live="polite"></div>
      </div>
    </div>

    {caption && <figcaption class="mbe-figure__caption">{caption}</figcaption>}
  </figure>
) : (
  <figure class="mbe-figure">
    <img class="mbe-figure__static" src={staticSrc} alt={caption || id} loading="lazy" />
    {caption && <figcaption class="mbe-figure__caption">{caption}</figcaption>}
  </figure>
)}

<script>
  // Bundled + run by Astro. Reads the contract from data-case — the attribute
  // survives because Astro doesn't sanitize component output.
  //
  // The simulation lives in /fmi/figure.js, which is imported when a figure
  // scrolls into view rather than on the Run click: it pulls a 2.2 MB driver and
  // instantiates the model, which measured ~2.2 s on the first press. Doing it
  // ahead of time makes Run the solve alone (~10 ms). A reader who never reaches
  // an interactive figure never fetches any of it.
  function hydrate() {
    document.querySelectorAll<HTMLElement>('.mbe-figure.interactive').forEach((fig) => {
      if (fig.dataset.hydrated) return;
      fig.dataset.hydrated = '1';
      const status = fig.querySelector<HTMLElement>('.mbe-figure__status');
      const runBtn = fig.querySelector<HTMLButtonElement>('.mbe-figure__run');
      const say = (text: string) => { if (status) status.textContent = text; };
      let mod: any = null;
      const load = async () => (mod ??= await import(/* @vite-ignore */ '/fmi/figure.js'));

      // One run at a time. A slider drag fires far faster than a solve returns,
      // so coalesce: keep only the most recent request and run it when the
      // current one finishes.
      let running = false, queued = false;
      const simulate = async () => {
        if (running) { queued = true; return; }
        running = true;
        if (runBtn) { runBtn.disabled = true; }
        try {
          const m = await load();
          await m.simulate(fig, say);
        } catch (e) {
          fig.dataset.state = 'static';
          say(e instanceof Error ? e.message : String(e));
        } finally {
          running = false;
          if (runBtn) runBtn.disabled = false;
          if (queued) { queued = false; simulate(); }
        }
      };

      runBtn?.addEventListener('click', simulate);

      // Slider and number box are two views of one value; each writes the other.
      fig.querySelectorAll<HTMLInputElement>('.mbe-param__slider').forEach((slider) => {
        const box = document.getElementById(slider.dataset.for || '') as HTMLInputElement | null;
        slider.addEventListener('input', () => {
          if (box) box.value = slider.value;
          simulate();
        });
        box?.addEventListener('change', () => {
          const v = Number(box.value);
          if (Number.isFinite(v)) slider.value = String(v);
        });
      });

      // Prepare when it comes into view; fall back to preparing immediately
      // where there is no observer.
      const prepare = async () => { const m = await load(); await m.prepare(fig, say); };
      if (typeof IntersectionObserver === 'function') {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            io.disconnect();
            'requestIdleCallback' in window
              ? (window as any).requestIdleCallback(prepare, { timeout: 2000 })
              : setTimeout(prepare, 200);
          }
        }, { rootMargin: '400px' });
        io.observe(fig);
      } else {
        setTimeout(prepare, 500);
      }
    });
  }
  hydrate();
  document.addEventListener('astro:page-load', hydrate);
</script>
