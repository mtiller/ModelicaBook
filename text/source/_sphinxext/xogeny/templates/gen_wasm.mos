// Generated by specs.py. Do not edit by hand.
//
// Exports one case as a WebAssembly-backed FMI 3.0 FMU, in both of the forms
// `--simCodeTarget=wasm-jit` can emit:
//
//   wasm/dylink/<case>.fmu     an unzipped directory holding the model kernel
//                              only, at binaries/wasm32-om-dylink/. Tiny (tens
//                              of KB), but it runs only in a host that links it
//                              against a prebuilt adapter, which today means an
//                              OpenModelica importer, not a browser.
//   wasm/component/<case>.fmu  a portable fmi-ls-wasm component at
//                              binaries/wasm32-wasip2/. ~2 MB (about 710 KB
//                              zipped) because it carries the runtime, and it
//                              is the form a browser can run today.
//
// The case's stopTime/tolerance/interval count and its parameter overrides are
// NOT baked in here: buildModelFMU takes no simulation settings, and `-override`
// is a runtime flag on the native path too. They live in
// results/json/<case>-case.json and are applied by the importer with fmi3Set*
// before initialization.
installPackage(Modelica, "3.2.3+maint.om", exactMatch=true);
setModelicaPath(getModelicaPath()+":"+"{{path}}");
setCommandLineOptions("+simCodeTarget=wasm-jit");
// Expose the protected and internal variables too, not just the public
// interface. The book plots what is *inside* its components -- sensor.room.T,
// controller.feedback.u2, controller.bus.heat_command -- and the default filter
// keeps those out of the model description, so six figures on the thermal
// control page had none of the variables they draw. The native pipeline makes
// the same choice with `-emit_protected -ignoreHideResult`. `internal` still
// drops the variables the symbolic transformation invents, which `none` would
// not. For Basic that is 95 variables instead of 26, and 84 KB instead of 64.
setCommandLineOptions("--fmiFilter=internal");
cf := loadModel(ModelicaByExample);
getErrorString();
if not cf then
  exit(1);
end if;

// --- dylink form -----------------------------------------------------------
// --fmuDirectory selects the unzipped, host-linked artifact.
setCommandLineOptions("+fmuDirectory=true");
dylink := buildModelFMU({{name}}, version="3.0", fmuType="me_cs",
                        fileNamePrefix="{{pre}}", platforms={"wasm"});
getErrorString();
if dylink == "" then
  exit(1);
end if;
if system("mkdir -p wasm/dylink && rm -rf wasm/dylink/{{pre}}.fmu && mv {{pre}}.fmu wasm/dylink/{{pre}}.fmu") <> 0 then
  exit(1);
end if;

// --- component form --------------------------------------------------------
setCommandLineOptions("+fmuDirectory=false");
component := buildModelFMU({{name}}, version="3.0", fmuType="me_cs",
                           fileNamePrefix="{{pre}}", platforms={"wasm"});
getErrorString();
if component == "" then
  exit(1);
end if;
if system("mkdir -p wasm/component && rm -f wasm/component/{{pre}}.fmu && mv {{pre}}.fmu wasm/component/{{pre}}.fmu") <> 0 then
  exit(1);
end if;

exit(0);
